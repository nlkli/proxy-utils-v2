{
    "experimental": {
        "cache_file": {
            "enabled": true
        },
        "clash_api": {
            "external_controller": "127.0.0.1:9090"
        }
    },
    "dns": {
        "servers": [
            {
                "tag": "remote",
                "type": "https",
                "server": "1.1.1.1",
                "detour": "proxy"
            },
            {
                "tag": "local",
                "type": "udp",
                "server": "77.88.8.8"
            }
        ],
        "rules": [
            {
                "domain_suffix": [
                    ".ru",
                    ".su",
                    ".рф"
                ],
                "action": "route",
                "server": "local"
            }
        ],
        "final": "remote",
        "strategy": "prefer_ipv4",
        "optimistic": true
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "address": [
                "172.18.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "auto_route": true,
            "strict_route": true
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct"
        },
        {
            "type": "hysteria2",
            "tag": "h2-out",
            "server": "",
            "server_port": 443,
            "password": "",
            "tls": {
                "enabled": true,
                "server_name": "",
                "insecure": true
            }
        },
        {
            "type": "socks",
            "tag": "s5-out",
            "server": "",
            "server_port": 9090,
            "version": "5",
            "username": "",
            "password": ""
        },
        {
            "type": "selector",
            "tag": "proxy",
            "outbounds": [
                "h2-out",
                "s5-out"
            ],
            "interrupt_exist_connections": true
        },
        {
            "type": "selector",
            "tag": "out",
            "outbounds": [
                "direct",
                "proxy"
            ],
            "interrupt_exist_connections": true
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "default_domain_resolver": "local",
        "rules": [
            {
                "action": "sniff"
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "domain_suffix": [
                    ".ru",
                    ".su",
                    ".рф"
                ],
                "outbound": "direct"
            }
        ],
        "final": "out"
    }
}

